{
  "name": "playwright-qa-demo",
  "version": "1.0.0",
  "private": true,
  "description": "UI and API test automation with Playwright and TypeScript, against public practice apps.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=mobile-safari",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
