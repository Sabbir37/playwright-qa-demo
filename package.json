{
  "name": "playwright-qa-demo",
  "version": "1.0.0",
  "private": true,
  "description": "UI and API test automation with Playwright and TypeScript, against public practice apps.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --project=chromium --project=mobile-safari",
    "test:api": "playwright test --project=api",
    "test:a11y": "playwright test --grep @a11y",
    "test:headed": "playwright test --project=chromium --headed --workers=1",
    "screenshots": "CAPTURE=1 playwright test known-bugs --project=chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
